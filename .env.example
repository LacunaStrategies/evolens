# ─────────────────────────────────────────────────────────────────────────────
# evolens env template
# ─────────────────────────────────────────────────────────────────────────────
#
# This is the ONLY env file committed to git. The three it seeds are created
# for you by `scripts/setup-env.mjs` on postinstall:
#   .env.development   ← used by pnpm start:development / pnpm android:development / etc.
#   .env.staging       ← used by pnpm start:staging      / pnpm android:staging      / etc.
#   .env.production    ← used by pnpm start:production   / pnpm android:production   / etc.
#   .env.local         ← generated by scripts/EAS hook from one of the files above.
#                        Any `:<env>` script rewrites it, so treat it as ephemeral.
#
# The generator never overwrites a file that exists, so your real values are
# safe across installs. Run `pnpm env:init` by hand after adding a key here —
# it reports which local files are missing it.
#
# All four files are gitignored, but .env.development / .env.staging /
# .env.production ARE uploaded to EAS cloud builds via .easignore.
# `scripts/eas-pre-install.sh` (run via the eas-build-pre-install package.json
# hook) copies the matching file to .env.local on the build server.
#
# Resolution order (highest → lowest priority, see load-env.ts):
#   Explicit APP_ENV mode (when scripts pass APP_ENV / EXPO_PUBLIC_APP_ENV):
#     1. process.env
#     2. .env.<APP_ENV>.local
#     3. .env.<APP_ENV>
#     4. .env.local
#     5. .env
#   Default mode (no explicit APP_ENV):
#     1. process.env
#     2. .env.<APP_ENV>.local
#     3. .env.local
#     4. .env.<APP_ENV>
#     5. .env
# ─────────────────────────────────────────────────────────────────────────────

# App environment: development | staging | production.
# Drives which app name and which logical env the runtime considers itself in.
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_API_URL=https://your-api.example.com/
